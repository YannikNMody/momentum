{
  "manifest_version": 3,
  "name": "Momentum Lite",
  "version": "0.1.0",
  "description": "A light version of Momentum: replaces the new tab page.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://site.api.espn.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
